# Server-only connection. Local values generated by npm run db:configure; never commit.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Exact browser origin, required for staff POST origin checks; adjust for local test port.
APP_ORIGIN=http://127.0.0.1:3000

# Guest admission is OFF by default. Local-only synthetic setup: npm run db:guest.
# No public deployment, production database or real customer booking is supported.
GUEST_INTENTS_ENABLED=false
GUEST_NETWORK_MODE=
GUEST_RATE_HMAC_KEY=
SUPABASE_GUEST_SERVICE_KEY=

# Local unpaid synthetic holds only, enabled by guarded db:guest bootstrap.
GUEST_RESERVATIONS_ENABLED=false
